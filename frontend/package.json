{
  "name": "building-point-locator-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/app.component.spec.ts --include=src/app/location.service.spec.ts",
    "test:integration": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/app.integration.spec.ts",
    "test:watch": "ng test"
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@eslint/js": "^9.35.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.2.0",
    "eslint": "^9.35.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0"
  }
